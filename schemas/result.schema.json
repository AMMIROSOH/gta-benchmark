{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GTA Benchmark result v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "task_version",
    "agent",
    "requested_model",
    "policy_mode",
    "status",
    "reason",
    "elapsed_seconds",
    "task_status",
    "task_reason",
    "artifacts_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manifest": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "task_version": {
      "type": "integer",
      "minimum": 1
    },
    "agent": {
      "type": "string"
    },
    "requested_model": {
      "type": "string"
    },
    "models_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_mode": {
      "enum": [
        "primitive_actions",
        "bounded_movement",
        "target_selection_with_road_controller",
        "agent_actions"
      ]
    },
    "action_interface": {
      "type": "string"
    },
    "executor_version": {
      "type": "string"
    },
    "invalid_commands_dropped": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "success",
        "failed",
        "completed",
        "incomplete"
      ]
    },
    "reason": {
      "type": "string"
    },
    "task_status": {
      "enum": [
        "success",
        "failed",
        "completed",
        "incomplete"
      ]
    },
    "task_reason": {
      "type": "string"
    },
    "artifacts_status": {
      "enum": [
        "finalizing",
        "complete",
        "failed"
      ]
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "started_at_utc": {
      "type": [
        "string",
        "null"
      ]
    },
    "finished_at_utc": {
      "type": [
        "string",
        "null"
      ]
    },
    "video": {
      "type": [
        "object",
        "null"
      ]
    },
    "reset": {
      "type": [
        "object",
        "null"
      ]
    },
    "final_state": {
      "type": [
        "object",
        "null"
      ]
    },
    "task_progress": {
      "type": "object"
    },
    "post_success_recording": {
      "type": "object"
    },
    "score": {
      "type": "integer"
    },
    "score_complete": {
      "type": "boolean"
    },
    "score_unit": {
      "enum": [
        "kills",
        "game_dollars"
      ]
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "task_status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "score",
          "score_unit",
          "score_complete"
        ],
        "properties": {
          "score_complete": {
            "const": true
          },
          "elapsed_seconds": {
            "const": 120
          }
        }
      }
    }
  ]
}
